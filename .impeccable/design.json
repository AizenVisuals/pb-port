  "narrative": {
    "northStar": "Light game panels around a living pixel partner",
    "overview": "PULSE ARENA uses warm ivory panels, navy graphite text and structural frames around colorful pixel creatures and original world art. Coral commands have shallow tactile depth; cyan distinguishes selection and progress. The game remains compact and landscape, with an animated favorite leading the lobby.\n\nThis records the approved light-game replacement, superseding the old dark menu rules while preserving the graphite/cyan/coral identity, bundled Barlow typography, pixel assets and high-contrast real-time battle HUD. Authority is PRODUCT.md and `.impeccable/surfaces/pulse-light-game.md`; the pinned Pokémon: Champion captures establish composition rather than reusable promotional art. No catalog roll, QUALITY BAR card or independently verified FORM seed was recorded.",
    "keyCharacteristics": [
      "Warm framed task panels and shallow bevels.",
      "Pixel creatures carry identity; world artwork carries place.",
      "Coral actions, cyan selection and explicit text states.",
      "Landscape workspaces with internal scrolling and persistent navigation."
    ],
    "rules": [
      {
        "name": "The Action and Selection Rule",
        "body": "Use coral for primary commands and cyan for selected inventory, formation and progress; keep state text alongside color.",
        "section": "colors"
      },
      {
        "name": "The Pixel Subject Rule",
        "body": "Preserve pixel rendering on creature and item assets; UI labels remain normal text.",
        "section": "typography"
      },
      {
        "name": "The Task Workspace Rule",
        "body": "Keep partner, formation, inventory, shop and invocation as separate tasks, with contextual Back and retained selection when returning.",
        "section": "layout"
      },
      {
        "name": "The Combat Contrast Rule",
        "body": "Keep the dark real-time HUD scoped to battle; light menu tokens must not reduce its control contrast.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the warm light panels and graphite structure of the approved replacement.",
      "Do show owned, locked, level, quantity and eligibility states in text.",
      "Do preserve pixel creature animation, with reduced-motion alternatives for interface transitions and reveals.",
      "Do keep primary commands reachable while task content scrolls."
    ],
    "donts": [
      "Don't restore the superseded dark menu system across management screens.",
      "Don't copy promotional character art, phone frames or monetization clutter from reference screenshots.",
      "Don't imply that formation position grants a front/back combat bonus or that acquisition rarity increases stats.",
      "Don't claim native performance or complete device coverage from browser screenshots."
    ]
  }
}
